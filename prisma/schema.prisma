// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserSiteRole {
  id      String   @id @default(uuid())
  user    User     @relation(fields: [userId], references: [id])
  userId  String

  siteId  String 
  role    String

  @@unique([userId, siteId])
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  password        String?
  firstName       String?
  lastName        String?
  phone           String?
  address         String?
  deletionReason  String?
  deletedAt       DateTime?
  externalId      String?
  authUserId      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  siteRoles       UserSiteRole[]

  @@map("users")
}